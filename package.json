{
  "name": "antigravity-vscode-panel",
  "displayName": "Antigravity Panel (Unofficial)",
  "description": "Unofficial integration of the Antigravity Agent Manager inside VS Code and VSCodium. Connects to the locally installed Antigravity app.",
  "version": "0.3.0",
  "publisher": "nicola-palo",
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "antigravity",
    "agent",
    "gemini",
    "ai"
  ],
  "main": "./extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/nicola-palo/antigravityVSplug-in.git"
  },
  "bugs": {
    "url": "https://github.com/nicola-palo/antigravityVSplug-in/issues"
  },
  "homepage": "https://github.com/nicola-palo/antigravityVSplug-in#readme",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "antigravity",
          "title": "Antigravity",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "antigravity": [
        {
          "type": "webview",
          "id": "antigravityPanel.view",
          "name": "Agent Manager"
        }
      ]
    },
    "commands": [
      {
        "command": "antigravityPanel.openTab",
        "title": "Antigravity: Open Agent Manager in a Tab"
      },
      {
        "command": "antigravityPanel.openProject",
        "title": "Antigravity: Open Current Project Folder in Antigravity"
      },
      {
        "command": "antigravityPanel.launchApp",
        "title": "Antigravity: Launch Application"
      },
      {
        "command": "antigravityPanel.showApp",
        "title": "Antigravity: Show Application Window"
      },
      {
        "command": "antigravityPanel.hideApp",
        "title": "Antigravity: Hide Application Window"
      },
      {
        "command": "antigravityPanel.configurePath",
        "title": "Antigravity: Configure Executable Path"
      },
      {
        "command": "antigravityPanel.reconnect",
        "title": "Antigravity: Reconnect to Server"
      }
    ],
    "configuration": {
      "title": "Antigravity Panel",
      "properties": {
        "antigravityPanel.executablePath": {
          "type": "string",
          "default": "",
          "description": "Path to Antigravity.exe (or Antigravity.app on macOS). If empty, looks in default system paths."
        },
        "antigravityPanel.port": {
          "type": "number",
          "default": 0,
          "description": "HTTP port of the Antigravity language server. 0 = auto-detect."
        },
        "antigravityPanel.autoLaunch": {
          "type": "boolean",
          "default": false,
          "description": "Automatically launch the Antigravity app if it is not running when the panel is opened."
        },
        "antigravityPanel.hideOnLaunch": {
          "type": "boolean",
          "default": true,
          "description": "Windows only: keep the Antigravity main window ALWAYS hidden while a watchdog is active (even manual launches get re-hidden). Use 'Antigravity: Show Application Window' to bring it up (pauses the watchdog), 'Antigravity: Hide Application Window' to hide it again."
        }
      }
    }
  },
  "scripts": {
    "package": "vsce package"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.0.0"
  }
}
